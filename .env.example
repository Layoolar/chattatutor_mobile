EXPO_PUBLIC_API_BASE_URL=https://api.chattatutor.com

# Google OAuth — create a project in https://console.cloud.google.com/
# and add the OAuth client IDs below. The web client ID is required (used by
# Expo Go and as a fallback). iOS / Android client IDs are required for
# standalone (EAS) builds — get them from the same Google project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
